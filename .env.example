# ==========================================
# DigOut - Environment Configuration Template
# ==========================================
# Copy this file to .env and provide your API keys:
# cp .env.example .env

# Database Password
POSTGRES_PASSWORD=password

# JWT Authentication Secret (Minimum 32 random characters for HS256)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_chars_long

# AES-256 Database Encryption Key (Must be exactly 32 characters)
DB_ENCRYPTION_KEY=DigoutSecKey2026DigoutSecKey2026

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LPU API Key (Get free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# USDA FoodData Central API Key (Get free at https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY=your_usda_api_key_here

# Google OAuth Client ID (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=599673748564-91607cjjv7fdd1c7n7erri8bc9mbl6mq.apps.googleusercontent.com

# Cloudflare Turnstile Secret Key (Optional - uses test key by default)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
